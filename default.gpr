project Default is
   for Source_Dirs use ("src/**", "src/stm32f40x/**");
   for Object_Dir use "obj";
   for Main use ("main.adb");
   for Languages use ("Ada", "Asm_Cpp");
   for Target use "arm-eabi";
   for Runtime ("ada") use "zfp-cortex-m4";

   package Compiler is
      for Default_Switches ("ada") use ("-O0", "-gnatwa");
   end Compiler;

   package Linker is
      for Switches ("ada") use ("-T", project'Project_Dir & "/src/link.ld", "-Wl,--gc-sections");
   end Linker;

   package Ide is
      for Program_Host use "localhost:4242";
      for Communication_Protocol use "remote";
      for Connection_Tool use "st-util";
   end Ide;
end Default;
